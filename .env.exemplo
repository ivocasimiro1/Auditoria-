# ============================================================
# EdgeBet — Configuração
# Copia este ficheiro para ".env" e preenche os valores.
# ============================================================

# ── Bot PRO (subscritores pagantes) ──────────────────────────
# Cria em @BotFather com /newbot
TELEGRAM_TOKEN=cola_aqui_o_token_do_bot_pro

# ── Bot Marketing (captação gratuita) ────────────────────────
# Cria um SEGUNDO bot em @BotFather
MARKETING_TOKEN=cola_aqui_o_token_do_bot_marketing

# ── Username do bot marketing (sem @) ────────────────────────
MARKETING_BOT_USERNAME=EdgeBetMarketingBot

# ── IDs Telegram dos administradores (separados por vírgula) ─
# Para saberes o teu ID: fala com @userinfobot no Telegram
ADMIN_IDS=123456789,987654321

# ── Odds API (opcional — mostra odds Bet365, Betclic, etc. nas dicas) ────────
# Registo GRATUITO em: https://the-odds-api.com/
# Plano gratuito: 500 pedidos/mês (suficiente para uso diário)
ODDS_API_KEY=
